# Local-only development defaults. Change these before exposing the stack publicly.
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
POSTGRES_DB=noc_portal
POSTGRES_USER=noc_portal
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://noc_portal:dev-only-change-me@db:5432/noc_portal
JWT_SECRET_KEY=local-development-secret-change-this-before-deployment-0001
SENTRY_DSN=
COOKIE_SECURE=false
APP_PORT=8000
APP_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_FULL_NAME=NOC Administrator
INITIAL_ADMIN_PASSWORD=ChangeMeNow123!
